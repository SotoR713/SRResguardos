@* Botones de estado de un toque, cada uno con su cuenta. Se usa con @bind-Elegido. *@
<div class="filtros" role="group" aria-label="@Etiqueta">
    @foreach (var opcion in Opciones)
    {
        var id = opcion.Id;
        var elegido = Elegido == id;

        <button type="button" class="filtro @(elegido ? "elegido" : "")"
                aria-pressed="@(elegido ? "true" : "false")"
                @onclick="() => ElegidoChanged.InvokeAsync(id)">
            @opcion.Nombre <span class="filtro-cuenta numero">@opcion.Cuenta</span>
        </button>
    }
</div>

@code {
    // Id nulo significa "todos"
    public record Opcion(int? Id, string Nombre, int Cuenta);

    [Parameter, EditorRequired] public IReadOnlyList<Opcion> Opciones { get; set; } = [];
    [Parameter] public int? Elegido { get; set; }
    [Parameter] public EventCallback<int?> ElegidoChanged { get; set; }
    [Parameter] public string Etiqueta { get; set; } = "Filtrar por estado";
}
