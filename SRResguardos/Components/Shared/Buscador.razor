@* Campo de búsqueda grande y redondo. Se usa con @bind-Texto. *@
<div class="buscador" role="search">
    <svg class="buscador-icono" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2" />
        <path d="M15.5 15.5 21 21" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
    </svg>
    <input type="search" class="buscador-campo"
           placeholder="@Ayuda"
           aria-label="@Etiqueta"
           value="@Texto"
           @oninput="CambiarAsync"
           @onkeydown="TeclaAsync" />
    @if (!string.IsNullOrEmpty(Texto))
    {
        <button type="button" class="buscador-limpiar" @onclick="LimpiarAsync" aria-label="Limpiar búsqueda">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
            </svg>
        </button>
    }
</div>

@code {
    [Parameter] public string Texto { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TextoChanged { get; set; }

    // Texto de ayuda dentro del campo, y nombre del campo para lectores de pantalla
    [Parameter] public string Ayuda { get; set; } = "Buscar";
    [Parameter] public string Etiqueta { get; set; } = "Buscar";

    // Cada tecla avisa a la página, que filtra al instante
    private Task CambiarAsync(ChangeEventArgs e) =>
        TextoChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private Task LimpiarAsync() => TextoChanged.InvokeAsync(string.Empty);

    private Task TeclaAsync(KeyboardEventArgs e) =>
        e.Key == "Escape" ? LimpiarAsync() : Task.CompletedTask;
}
