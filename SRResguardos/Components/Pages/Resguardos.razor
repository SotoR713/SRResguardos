@page "/resguardos"
@rendermode InteractiveServer
@using SRResguardos.Application.DTOs
@using SRResguardos.Application.Interfaces.Persistence
@inject IResguardoRepository RepositorioResguardos
@inject ICatalogoRepository RepositorioCatalogos


<PageTitle>Resguardos</PageTitle>

<h1>Resguardos</h1>

<div class="mb-3" style="max-width: 300px;">
    <label class="form-label">Filtrar por estado</label>
    <select class="form-select" value="@_estadoId" @onchange="CambiarEstado">
        <option value="">Todos</option>
    @foreach (var estado in _estados)
        {
            <option value="@estado.Id">@estado.Nombre</option>
        }
    </select>
</div>

@if (_resguardos is null)
{
    <p>Cargando...</p>
}
else if (_resguardos.Count == 0)
{
    <p>No hay resguardos con ese estado.</p>
}
else
{
    <p>@_resguardos.Count resguardo(s)</p>

    <table class="table">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Folio</th>
                <th>Colaborador</th>
                <th>Puesto</th>
                <th>Tipo</th>
                <th>Bien</th>
                <th>Estado</th>
                <th>Estado del bien</th>
                <td><a href="resguardos/@r.Id/responsiva">Ver</a></td>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _resguardos)
            {
                <tr>
                    <td>@r.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@r.NumeroSerie</td>
                    <td>@r.Colaborador</td>
                    <td>@r.Puesto</td>
                    <td>@r.TipoBien</td>
                    <td>@r.IdentificadorBien</td>
                    <td>@r.EstadoResguardo</td>
                    <td>@r.EstadoBien</td>
                    <td><a href="resguardos/@r.Id/responsiva">Ver</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<ResguardoListaDto>? _resguardos;
    private int? _estadoId;
    private IReadOnlyList<CatalogoDto> _estados = [];

    protected override async Task OnInitializedAsync()
    {
        _estados = await RepositorioCatalogos.ObtenerEstadosResguardoAsync();
        await CargarAsync();
    }

    private async Task CambiarEstado(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString();

        _estadoId = string.IsNullOrEmpty(valor) ? null : int.Parse(valor);

        _resguardos = null;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _resguardos = await RepositorioResguardos.ObtenerListaAsync(_estadoId);
    }
}