@page "/resguardos"
@rendermode InteractiveServer
@using SRResguardos.Application.DTOs
@using SRResguardos.Application.Interfaces.Persistence
@using SRResguardos.Domain.Enums
@inject IResguardoRepository RepositorioResguardos
@inject ICatalogoRepository RepositorioCatalogos
@inject IJSRuntime JS

<PageTitle>Resguardos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Resguardos</h1>
    <a class="btn btn-primary" href="resguardos/nuevo">Asignar resguardo</a>
</div>

<div class="mb-3" style="max-width: 300px;">
    <label class="form-label">Filtrar por estado</label>
    <select class="form-select" value="@_estadoId" @onchange="CambiarEstado">
        <option value="">Todos</option>
        @foreach (var estado in _estados)
        {
            <option value="@estado.Id">@estado.Nombre</option>
        }
    </select>
</div>

@if (_mensaje is not null)
{
    <div class="alert @(_esError ? "alert-danger" : "alert-success")">@_mensaje</div>
}

@if (_resguardos is null)
{
    <p>Cargando...</p>
}
else if (_resguardos.Count == 0)
{
    <p>No hay resguardos con ese estado.</p>
}
else
{
    <p>@_resguardos.Count resguardo(s)</p>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Folio</th>
                    <th>Colaborador</th>
                    <th>Puesto</th>
                    <th>Tipo</th>
                    <th>Bien</th>
                    <th>Estado</th>
                    <th>Estado del bien</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _resguardos)
                {
                    <tr>
                        <td>@r.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@r.NumeroSerie</td>
                        <td>@r.Colaborador</td>
                        <td>@r.Puesto</td>
                        <td>@r.TipoBien</td>
                        <td>@r.IdentificadorBien</td>
                        <td>@r.EstadoResguardo</td>
                        <td>@r.EstadoBien</td>
                        <td class="text-nowrap">
                            <a href="resguardos/@r.Id/responsiva">Ver</a>
                            @if (r.EstadoResguardoId == (int)EstadoResguardo.Activo)
                            {
                                <button class="btn btn-sm btn-outline-warning ms-2"
                                        @onclick="() => DevolverAsync(r)">
                                    Devolver
                                </button>
                                <button class="btn btn-sm btn-outline-danger ms-1"
                                        @onclick="() => CancelarAsync(r)">
                                    Cancelar
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<ResguardoListaDto>? _resguardos;
    private IReadOnlyList<CatalogoDto> _estados = [];
    private int? _estadoId;
    private string? _mensaje;
    private bool _esError;

    protected override async Task OnInitializedAsync()
    {
        _estados = await RepositorioCatalogos.ObtenerEstadosResguardoAsync();
        await CargarAsync();
    }

    private async Task CambiarEstado(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString();

        _estadoId = string.IsNullOrEmpty(valor) ? null : int.Parse(valor);

        _resguardos = null;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _resguardos = await RepositorioResguardos.ObtenerListaAsync(_estadoId);
    }

    private Task DevolverAsync(ResguardoListaDto r) => EjecutarAsync(
        $"¿Registrar la devolución del bien {r.IdentificadorBien} de {r.Colaborador}?",
        () => RepositorioResguardos.DevolverAsync(r.Id),
        $"Resguardo {r.NumeroSerie} devuelto.");

    private Task CancelarAsync(ResguardoListaDto r) => EjecutarAsync(
        $"¿Cancelar el resguardo {r.NumeroSerie} por error de captura? El folio no se reutiliza.",
        () => RepositorioResguardos.CancelarAsync(r.Id),
        $"Resguardo {r.NumeroSerie} cancelado.");

    // Devolver y cancelar siguen los mismos pasos: confirmar, ejecutar, avisar y recargar.
    private async Task EjecutarAsync(string pregunta, Func<Task> accion, string mensajeExito)
    {
        if (!await JS.InvokeAsync<bool>("confirm", pregunta))
            return;

        try
        {
            await accion();
            _mensaje = mensajeExito;
            _esError = false;
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            _mensaje = ex.Message;
            _esError = true;
        }
    }
}
