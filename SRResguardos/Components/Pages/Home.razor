@page "/"
@using SRResguardos.Application.DTOs
@using SRResguardos.Application.Interfaces.Persistence
@using SRResguardos.Domain.Enums
@inject IBienRepository RepositorioBienes
@inject IResguardoRepository RepositorioResguardos
@inject IEmpleadoRepository RepositorioEmpleados

<PageTitle>Inicio</PageTitle>

<h1>Control de resguardos</h1>
<p class="text-muted">Famoso</p>

@if (_bienes is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="row g-3 mb-4">
        <Indicador Titulo="Disponibles" Valor="@Contar(EstadoBien.Disponible)" Clase="cifra-disponible" Enlace="bienes" />
        <Indicador Titulo="Asignados" Valor="@Contar(EstadoBien.Asignado)" Clase="cifra-asignado" Enlace="bienes" />
        <Indicador Titulo="En mantenimiento" Valor="@Contar(EstadoBien.Mantenimiento)" Clase="cifra-mantenimiento" Enlace="bienes" />
        <Indicador Titulo="Resguardos activos" Valor="@_resguardosActivos" Clase="" Enlace="resguardos" />
        <Indicador Titulo="Empleados activos" Valor="@_empleadosActivos" Clase="" Enlace="empleados" />
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-primary" href="resguardos/nuevo">Asignar resguardo</a>
        <a class="btn btn-outline-primary" href="bienes/nuevo">Registrar bien</a>
    </div>
}

@code {
    private IReadOnlyList<BienBusquedaDto>? _bienes;
    private int _resguardosActivos;
    private int _empleadosActivos;

    protected override async Task OnInitializedAsync()
    {
        _bienes = await RepositorioBienes.ObtenerParaBusquedaAsync();
        _resguardosActivos = (await RepositorioResguardos.ObtenerListaAsync((int)EstadoResguardo.Activo)).Count;
        _empleadosActivos = (await RepositorioEmpleados.ObtenerListaAsync())
            .Count(e => e.EstatusId == (int)EstatusEmpleado.Activo);
    }

    private int Contar(EstadoBien estado) =>
        _bienes!.Count(b => b.EstadoId == (int)estado);
}
