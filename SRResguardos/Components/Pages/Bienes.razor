@page "/bienes"
@rendermode InteractiveServer
@using SRResguardos.Application.DTOs
@using SRResguardos.Application.Interfaces.Persistence
@using SRResguardos.Domain.Enums
@inject IBienRepository RepositorioBienes
@inject ICatalogoRepository RepositorioCatalogos
@inject IJSRuntime JS

<PageTitle>Bienes</PageTitle>

<div class="cabecera-lista">
    <div>
        <h1>Bienes</h1>
        @if (_bienes is not null)
        {
            <p class="resumen">@Resumen</p>
        }
    </div>
    <a class="btn btn-primary" href="bienes/nuevo">Nuevo bien</a>
</div>

<Buscador @bind-Texto="_busqueda"
          Ayuda="Busca por identificador, marca, modelo, serie, IMEI o teléfono"
          Etiqueta="Buscar bienes" />

<FiltroEstados Opciones="OpcionesFiltro" @bind-Elegido="_estadoId" />

@if (_mensaje is not null)
{
    <div class="alert @(_esError ? "alert-danger" : "alert-success")">@_mensaje</div>
}

@if (_bienes is null)
{
    <p class="text-muted">Cargando bienes...</p>
}
else if (_bienes.Count == 0)
{
    <div class="vacio">
        <p>Todavía no hay bienes registrados.</p>
        <a class="btn btn-primary" href="bienes/nuevo">Registrar el primero</a>
    </div>
}
else if (!Visibles.Any())
{
    <div class="vacio">
        @if (_busqueda.Trim().Length > 0)
        {
            <p>Ningún bien coincide con «@_busqueda.Trim()». Prueba con parte de la serie, el IMEI, el modelo o el identificador.</p>
            <button type="button" class="btn btn-outline-primary" @onclick="() => _busqueda = string.Empty">Limpiar búsqueda</button>
        }
        else
        {
            <p>No hay bienes en este estado.</p>
            <button type="button" class="btn btn-outline-primary" @onclick="() => _estadoId = null">Ver todos</button>
        }
    </div>
}
else
{
    <div class="tabla-contenedor">
        <table class="tabla">
            <thead>
                <tr>
                    <th scope="col">Identificador</th>
                    <th scope="col">Equipo</th>
                    <th scope="col">Datos de identificación</th>
                    <th scope="col">Estado</th>
                    <th scope="col"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Visibles)
                {
                    var estado = (EstadoBien)b.EstadoId;
                    var datos = Identificacion(b).ToList();

                    <tr>
                        <td><span class="principal numero">@b.Identificador</span></td>
                        <td>
                            <span class="principal">@b.Descripcion</span>
                            <span class="secundario">@b.TipoBien</span>
                        </td>
                        <td>
                            @if (datos.Count == 0)
                            {
                                <span class="sin-datos">Sin serie</span>
                            }
                            @foreach (var (etiqueta, valor) in datos)
                            {
                                <span class="dato">
                                    <span class="dato-etiqueta">@etiqueta</span>
                                    <span class="numero">@valor</span>
                                </span>
                            }
                        </td>
                        <td><span class="estado @ClaseEstado(estado)">@b.Estado</span></td>
                        <td class="acciones">
                            @if (estado is EstadoBien.Disponible or EstadoBien.Asignado)
                            {
                                <button class="btn btn-sm btn-outline-warning" @onclick="() => MantenimientoAsync(b)">Mantenimiento</button>
                            }
                            @if (estado == EstadoBien.Mantenimiento)
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => TerminarAsync(b)">Terminar mantenimiento</button>
                            }
                            @if (estado is EstadoBien.Disponible or EstadoBien.Mantenimiento)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => BajaAsync(b)">Dar de baja</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<BienBusquedaDto>? _bienes;
    private IReadOnlyList<CatalogoDto> _estados = [];
    private int? _estadoId;
    private string _busqueda = string.Empty;
    private string? _mensaje;
    private bool _esError;

    protected override async Task OnInitializedAsync()
    {
        _estados = await RepositorioCatalogos.ObtenerEstadosBienesAsync();
        await CargarAsync();
    }

    // Se cargan todos una vez; buscar y filtrar ocurre en memoria.
    private async Task CargarAsync()
    {
        _bienes = await RepositorioBienes.ObtenerParaBusquedaAsync();
    }

    // "lenovo e16" encuentra la Lenovo Thinkpad E16; también busca por serie, IMEI o teléfono.
    private bool Coincide(BienBusquedaDto b) => Busqueda.Coincide(_busqueda,
        b.Identificador, b.TipoBien, b.Descripcion, b.Marca, b.Modelo, b.Serie, b.Telefono, b.Estado);

    private IEnumerable<BienBusquedaDto> CoincidenConBusqueda =>
        (_bienes ?? []).Where(Coincide);

    private IEnumerable<BienBusquedaDto> Visibles =>
        CoincidenConBusqueda.Where(b => _estadoId is null || b.EstadoId == _estadoId);

    private int Contar(int? estadoId) =>
        CoincidenConBusqueda.Count(b => estadoId is null || b.EstadoId == estadoId);

    private IReadOnlyList<FiltroEstados.Opcion> OpcionesFiltro =>
        [new(null, "Todos", Contar(null)), .. _estados.Select(e => new FiltroEstados.Opcion(e.Id, e.Nombre, Contar(e.Id)))];

    private string Resumen
    {
        get
        {
            var total = _bienes!.Count;
            var disponibles = _bienes.Count(b => b.EstadoId == (int)EstadoBien.Disponible);
            var visibles = Visibles.Count();

            if (visibles != total)
                return $"Mostrando {visibles} de {total}";

            return $"{total} {(total == 1 ? "bien" : "bienes")}, {disponibles} {(disponibles == 1 ? "disponible" : "disponibles")}";
        }
    }

    // Lo que identifica a cada equipo físicamente. El modelo ya aparece junto a la marca
    // en la columna Equipo, así que aquí no se repite.
    private static IEnumerable<(string Etiqueta, string Valor)> Identificacion(BienBusquedaDto b)
    {
        switch ((TipoBien)b.TipoBienId)
        {
            case TipoBien.Celular:
                if (!string.IsNullOrEmpty(b.Serie))
                    yield return ("IMEI", b.Serie);
                if (!string.IsNullOrEmpty(b.Telefono))
                    yield return ("Tel.", b.Telefono);
                break;

            case TipoBien.Laptop:
            case TipoBien.Vehiculo:
                if (!string.IsNullOrEmpty(b.Serie))
                    yield return ("Serie", b.Serie);
                break;
        }
    }

    private static string ClaseEstado(EstadoBien estado) => estado switch
    {
        EstadoBien.Disponible => "estado-disponible",
        EstadoBien.Asignado => "estado-asignado",
        EstadoBien.Mantenimiento => "estado-mantenimiento",
        _ => "estado-baja"
    };

    private Task MantenimientoAsync(BienBusquedaDto b) => EjecutarAsync(
        null,
        () => RepositorioBienes.EnviarAMantenimientoAsync(b.Identificador),
        $"{b.Identificador} enviado a mantenimiento.");

    private Task TerminarAsync(BienBusquedaDto b) => EjecutarAsync(
        null,
        () => RepositorioBienes.TerminarMantenimientoAsync(b.Identificador),
        $"{b.Identificador} salió de mantenimiento.");

    private Task BajaAsync(BienBusquedaDto b) => EjecutarAsync(
        $"¿Dar de baja {b.Identificador} ({b.Descripcion})? Esta acción no se puede deshacer.",
        () => RepositorioBienes.DarDeBajaAsync(b.Identificador),
        $"{b.Identificador} dado de baja.");

    private async Task EjecutarAsync(string? pregunta, Func<Task> accion, string mensajeExito)
    {
        if (pregunta is not null && !await JS.InvokeAsync<bool>("confirm", pregunta))
            return;

        try
        {
            await accion();
            _mensaje = mensajeExito;
            _esError = false;
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            _mensaje = ex.Message;
            _esError = true;
        }
    }
}
