@page "/empleados"
@rendermode InteractiveServer
@using SRResguardos.Application.DTOs
@using SRResguardos.Application.Interfaces.Persistence
@using SRResguardos.Domain.Enums
@inject IEmpleadoRepository RepositorioEmpleados
@inject ICatalogoRepository RepositorioCatalogos
@inject IJSRuntime JS

<PageTitle>Empleados</PageTitle>

<h1>Empleados</h1>

<div class="card mb-4" style="max-width: 500px;">
    <div class="card-body">
        <h5 class="card-title">Nuevo empleado</h5>

        <EditForm Model="_nuevo" OnValidSubmit="GuardarAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <InputText class="form-control" @bind-Value="_nuevo.Nombre" />
                <ValidationMessage For="() => _nuevo.Nombre" />
            </div>

            <div class="mb-3">
                <label class="form-label">Puesto</label>
                <InputSelect class="form-select" @bind-Value="_nuevo.PuestoId">
                    <option value="0">Elige un puesto...</option>
                    @foreach (var p in _puestos)
                    {
                        <option value="@p.Id">@p.Nombre</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => _nuevo.PuestoId" />
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
        </EditForm>
    </div>
</div>

@if (_mensaje is not null)
{
    <div class="alert @(_esError ? "alert-danger" : "alert-success")">@_mensaje</div>
}

@if (_empleados is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Puesto</th>
                    <th>Estatus</th>
                    <th class="text-center">Resguardos activos</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in _empleados)
                {
                    var activo = emp.EstatusId == (int)EstatusEmpleado.Activo;

                    <tr class="@(activo ? "" : "text-muted")">
                        <td><a href="empleados/@emp.Id">@emp.Nombre</a></td>
                        <td>@emp.Puesto</td>
                        <td>@emp.Estatus</td>
                        <td class="text-center">@emp.ResguardosActivos</td>
                        <td>
                            @if (!activo)
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => ActivarAsync(emp)">Activar</button>
                            }
                            else if (emp.ResguardosActivos == 0)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => InactivarAsync(emp)">Inactivar</button>
                            }
                            else
                            {
                                <span class="small text-muted">Con bienes asignados</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<EmpleadoListaDto>? _empleados;
    private IReadOnlyList<CatalogoDto> _puestos = [];
    private NuevoEmpleadoDto _nuevo = new();
    private string? _mensaje;
    private bool _esError;

    protected override async Task OnInitializedAsync()
    {
        _puestos = await RepositorioCatalogos.ObtenerPuestosAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _empleados = await RepositorioEmpleados.ObtenerListaAsync();
    }

    private async Task GuardarAsync()
    {
        try
        {
            await RepositorioEmpleados.CrearAsync(_nuevo);
            Avisar($"Empleado '{_nuevo.Nombre.Trim()}' dado de alta.", false);
            _nuevo = new();
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            Avisar(ex.Message, true);
        }
    }

    private async Task ActivarAsync(EmpleadoListaDto emp)
    {
        try
        {
            await RepositorioEmpleados.ActivarAsync(emp.Id);
            Avisar($"{emp.Nombre} está activo.", false);
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            Avisar(ex.Message, true);
        }
    }

    private async Task InactivarAsync(EmpleadoListaDto emp)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Inactivar a {emp.Nombre}?"))
            return;

        try
        {
            await RepositorioEmpleados.InactivarAsync(emp.Id);
            Avisar($"{emp.Nombre} quedó inactivo.", false);
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            Avisar(ex.Message, true);
        }
    }

    private void Avisar(string texto, bool esError)
    {
        _mensaje = texto;
        _esError = esError;
    }
}
